# Snap2Form AI — environment variables
#
# Provide ONE of the following multimodal (vision-capable) AI provider keys.
# Priority if more than one is set: Gemini, then OpenAI, then Anthropic.
# This file is loaded automatically on startup (server/index.ts calls
# process.loadEnvFile()). Never expose these keys to the frontend — they are
# read only in server/services/ai.ts.

# Google Gemini (uses gemini-2.5-flash for vision by default)
GEMINI_API_KEY=
# Optional: override the Gemini model (default: gemini-2.5-flash)
GEMINI_MODEL=

# OpenAI (uses gpt-4o-mini / gpt-4o for vision)
OPENAI_API_KEY=

# Anthropic Claude (uses a vision-capable Claude model)
ANTHROPIC_API_KEY=

# Optional: override the port (Replit provides this automatically)
PORT=3000
