# Snap2Form AI — environment variables
#
# Provide ONE of the following multimodal (vision-capable) AI provider keys.
# The server picks whichever is present (OpenAI is checked first).
# Never expose these keys to the frontend — they are read only in server/services/ai.ts.

# OpenAI (uses gpt-4o-mini / gpt-4o for vision)
OPENAI_API_KEY=

# Anthropic Claude (uses a vision-capable Claude model)
ANTHROPIC_API_KEY=

# Optional: override the port (Replit provides this automatically)
PORT=3000
